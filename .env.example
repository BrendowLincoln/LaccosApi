# Copie para .env e troque os valores. O arquivo .env não vai para o Git.

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
FRONTEND_BASE_URL=http://localhost:4200

# O prefixo LACOOS_ evita colisão com POSTGRES_* definidas na máquina: o Compose prefere o ambiente ao .env.
LACOOS_DB_NAME=lacoos
LACOOS_DB_USER=lacoos
LACOOS_DB_PASSWORD=troque-esta-senha
LACOOS_DB_PORT=5433

# Em desenvolvimento, os e-mails ficam no Mailpit: http://localhost:8025
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@lacoos.local

# Dados de exemplo. Use só em desenvolvimento.
SEED_ENABLED=true
SEED_DEMO_PASSWORD=troque-esta-senha-demo
