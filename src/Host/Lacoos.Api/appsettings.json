{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "Auth": {
    "SessionDays": 14,
    "SecureCookies": true,
    "PasswordResetMinutes": 60,
    "RateLimitPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "FileStorage": {
    "RootPath": "data/uploads"
  },
  "Seed": {
    "Enabled": false
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseTls": false,
    "From": "nao-responda@lacoos.local",
    "FromName": "Laçoos"
  }
}
